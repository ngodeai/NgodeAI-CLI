// Provider-wire compat for "ngodeai": the first-party gateway this build ships
// pointed at by default.
//
// `https://llm.ngodeai.net/v1` speaks OpenAI Chat Completions, so the transport
// is `openai-completions`. There are deliberately no seed rows: the gateway is
// the only authority on which models an account can reach and what they cost,
// and a bundled fallback row is indistinguishable from a real one in the
// picker. When discovery fails the user should see an empty list and an error,
// not a plausible-looking model that cannot be selected.
//
// `default-model` names the alias the gateway routes automatically, so a
// session has something to start with before the roster arrives. It does NOT
// create a row — without a `seed` block nothing is bundled, and the id only
// resolves once discovery has returned it.
provider "ngodeai" {
	default-model "ngodeai/auto"
	env "NGODEAI_API_KEY"
	allow-unauthenticated #true
	discovery label="NgodeAI" allow-unauthenticated=#true
}
